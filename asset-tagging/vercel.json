{
    "version": 2,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/asset-tagging/(.*)",
            "dest": "api/index.php"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ]
}
